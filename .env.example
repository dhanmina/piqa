# Supabase — safe to expose in the client bundle (protected by Row-Level Security)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_publishable_key

# NEVER put secret keys (sb_secret_..., service_role) in an EXPO_PUBLIC_* var —
# they get bundled into the app. Use server-side only.
