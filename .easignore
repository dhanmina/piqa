# EAS upload ignore list. Mirrors .gitignore, but INTENTIONALLY does NOT ignore
# google-services.json — that file is gitignored (kept out of source control) yet
# MUST be uploaded to the EAS build so FCM initializes. Everything else stays
# excluded, including the FCM admin-SDK private key (that goes via `eas credentials`,
# never in the project archive).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Signing & service credentials (never upload — release keys, push configs)
credentials.json
GoogleService-Info.plist
# Firebase Admin SDK / FCM V1 service-account private key — via eas credentials, never in the archive
*-adminsdk-*.json
*firebase-adminsdk*

# Metro
.metro-health-check*

# debug & logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
logs/

# editors
.idea/
*.swp

# macOS
.DS_Store
*.pem

# local env files & secrets
.env
.env.*
!.env.example
*.env
secrets.json
*.secret

# Supabase seed carries a working password — keep it out of the build too.
supabase/seed.sql

# AI / agent tooling
.claude/settings.local.json

# typescript
*.tsbuildinfo

example

# generated native folders (regenerated by prebuild during the build)
/ios
/android

# Local dev overrides
.env.local
