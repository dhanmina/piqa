# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Signing & service credentials (never commit — release keys, push configs)
credentials.json
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug & logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
logs/

# editors
.idea/
*.swp

# macOS
.DS_Store
*.pem

# local env files & secrets
.env
.env.*
!.env.example
*.env
secrets.json
*.secret

# Supabase seed carries a working password for live seed/house accounts —
# keep it local. Commit supabase/seed.example.sql (sanitized) instead.
supabase/seed.sql

# AI / agent tooling — commit shared config (AGENTS.md, CLAUDE.md,
# .claude/settings.json); keep per-developer local overrides out.
.claude/settings.local.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Local dev overrides
.env.local
