{
  "expo": {
    "name": "piqa",
    "slug": "piqa",
    "scheme": "piqa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joinpiqa.app",
      "versionCode": 20,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "./plugins/withIncreasedGradleMemory",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Streak",
              "label": "piqa streak",
              "description": "Your current piqa streak. Updates each time you open the app.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-splash-screen",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "695fe1c2-f6a3-485f-b8b9-1b0314618f44"
      }
    },
    "owner": "dhanmina",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/695fe1c2-f6a3-485f-b8b9-1b0314618f44"
    }
  }
}
